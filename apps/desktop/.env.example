# apps/desktop dev-переопределения (скопируйте в .env.local; файл gitignored).
# Prod-сборка НЕ читает .env.local (проверяется в CI).

# API приложения
FLIGHTLOG_API_URL=http://localhost:3000

# UI сайта (Next.js dev-сервер)
FLIGHTLOG_WEB_URL=http://localhost:3001

# Канал обновлений: latest | beta
# FLIGHTLOG_CHANNEL=beta

# Update-feed (dev по умолчанию выключен)
# FLIGHTLOG_UPDATE_URL=https://updates.example/desktop/win/latest

# Данные агента (токены/outbox/логи)
# FLIGHTLOG_DATA_DIR=%APPDATA%\Flare

# T123: файловый лог main/agent-host (трей-приложение без консоли).
# По умолчанию <FLIGHTLOG_DATA_DIR>\agent\client.log; `off` отключает.
# FLIGHTLOG_LOG_FILE=%FLIGHTLOG_DATA_DIR%\agent\client.log
# FLIGHTLOG_LOG_FILE=off

# Протокол SimConnect (MSFS 2024 = sunrise)
# SIMCONNECT_PROTOCOL=sunrise
# AGENT_MAX_SAMPLE_HZ=10

# Не запускать агент автоматически при старте приложения
# FLIGHTLOG_AGENT_AUTOSTART=0

# T132: единственный OS-выход — action-required «потеря авторизации устройства»
# (включён по умолчанию; `0` глушит на уровне развёртывания).
# FLIGHTLOG_AUTH_ALERTS_ENABLED=0

# Только для dev: разрешить plaintext-хранилище токена при недоступном safeStorage
# FLIGHTLOG_ALLOW_FILE_TOKEN_STORE=1

# Smoke: in-memory outbox (без native better-sqlite3 под Electron ABI)
# FLIGHTLOG_AGENT_MEMORY_BUFFER=1

# GlitchTip DSN для краш-диагностики (T118). Opt-in в About; без DSN ничего не отправляется.
# GLITCHTIP_DSN=https://<public_key>@glitchtip.example/1
